# TableBite frontend configuration (copy to .env.local if you need to change anything).

# Where the Vite dev server proxies the Java backend (defaults shown).
# API_PROXY_TARGET=http://localhost:8080
# WS_PROXY_TARGET=ws://localhost:8081

# Only needed when the frontend is hosted separately from the backend
# (e.g. a static build on another domain). By default the app calls /api and /ws
# on its own origin through the proxy, which also works for phones on your Wi-Fi.
# VITE_API_URL=https://api.example.com/api
# VITE_WS_URL=wss://api.example.com/ws

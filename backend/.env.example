# TableBite backend configuration (environment variables).
# Copy the values you need into your shell / run configuration. Never commit real secrets.

# --- Database (required) ---------------------------------------------------
DB_USER=postgres
DB_PASSWORD=change-me
# Optional: defaults to jdbc:postgresql://localhost:5432/tablebite_db
# DB_URL=jdbc:postgresql://localhost:5432/tablebite_db
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=tablebite_db
# Set to false to skip the automatic, idempotent schema migrations on start-up.
# DB_AUTO_MIGRATE=true

# --- Ports -----------------------------------------------------------------
HTTP_PORT=8080
WEBSOCKET_PORT=8081
TCP_PORT=5000

# --- First administrator (created only when no admin exists yet) -----------
# If unset, a development admin admin@tablebite.local / Admin@12345 is created.
# ADMIN_EMAIL=owner@yourrestaurant.com
# ADMIN_PASSWORD=a-long-unique-password
# Demo kitchen / waiter / customer accounts (set to false in production)
SEED_DEMO_ACCOUNTS=true

# --- Optional ----------------------------------------------------------------
# Session lifetime in hours (default 168 = 7 days)
# SESSION_TTL_HOURS=168
# Where uploaded dish photos are stored (default ./uploads)
# UPLOAD_DIR=uploads
# CORS origin for the REST API (default *; bearer tokens are used, not cookies)
# CORS_ORIGIN=*
# --- Kitchen display code ----------------------------------------------------
# The kitchen opens http://<host>:5173/kitchen and types this code (no account needed).
# If unset, the development code "kitchen123" is used - change it!
KITCHEN_ACCESS_CODE=kitchen123
